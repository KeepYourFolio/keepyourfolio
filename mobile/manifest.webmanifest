{
  "name": "Keep Your Folio Mobile",
  "short_name": "Keep Your Folio",
  "description": "Saisie d’opérations chiffrée pour Keep Your Folio",
  "lang": "fr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#11151f",
  "theme_color": "#11151f",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon-mono-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "monochrome"
    }
  ],
  "shortcuts": [
    {"name": "Patrimoine", "short_name": "Patrimoine", "description": "Voir mon patrimoine", "url": "./?go=pat", "icons": [{"src": "icon-192.png", "sizes": "192x192", "type": "image/png"}]},
    {"name": "Comptes", "short_name": "Comptes", "description": "Voir mes comptes", "url": "./?go=cpt", "icons": [{"src": "icon-192.png", "sizes": "192x192", "type": "image/png"}]},
    {"name": "Saisie rapide", "short_name": "Saisie", "description": "Dicter ou écrire une opération", "url": "./?go=voix", "icons": [{"src": "icon-192.png", "sizes": "192x192", "type": "image/png"}]}
  ],
  "share_target": {
    "action": "./partage-recu",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "images",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}